<html>
  <head>
      <title>Index</title>
  </head>
  <body>

    <div class="container">

      <h1>Messages</h1> 

      <% messages.forEach(message => { %>

        <div>

          <%- include('message', { message: message }) %>

        </div>

      <% }); %>

    </div>
    
  </body>

</html>