<div class="msgDiv">
    <% if (locals.user && locals.user.membership == 'admin') {%>
        <div class="msgTop">
            <h3><%= message.title %></h3>
            <p><%= message.text %></p>
        </div>
        <p>&nbsp;</p>
        <div class="msgBot">
            <p>By: <%= message.username %></p>
            <p>Posted: <%= message.timestamp %></p>
            <p><a href="/delete-message/<%= message.id %>">Delete message</a></p>
        </div>
    <% } else if (locals.user && locals.user.membership == 'yes') { %>
        <div class="msgTop">
            <h3><%= message.title %></h3>
            <p><%= message.text %></p>
        </div>
        <p>&nbsp;</p>
        <div class="msgBot">
            <p>By: <%= message.username %></p>
            <p>Posted: <%= message.timestamp %></p>
        </div>
    <% } else { %>
        <div class="msgTop">
            <h3><%= message.title %></h3>
            <p><%= message.text %></p>
        </div>
    <%}%>
</div>