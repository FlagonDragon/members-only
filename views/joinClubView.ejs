<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <link type="text/css" href="/css/styles.css" rel="stylesheet">
</head>
<body>

  <h1>Join the Club</h1>

  <%- include("partials/errors.ejs") %>

  <% if (locals.user) { %>

      <form action="/join-club" method="POST">
        <label for="passcode">Passcode</label>
        <input id="passcode" name="passcode" placeholder="passcode" type="text" />
        <button type="submit">Join</button>
      </form>

    <% } else { %>
      
      <p>Must be logged in to access!</p>

    <%}%>

</body>
</html>