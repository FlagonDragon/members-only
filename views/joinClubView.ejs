<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
</head>
<body>
  <h1>Join the Club</h1>
  <form action="/join-club" method="POST">
    <label for="username">Email</label>
    <input id="username" name="username" placeholder="email" type="text" />
    <label for="passcode">Passcode</label>
    <input id="passcode" name="passcode" placeholder="passcode" type="text" />
    <button type="submit">Join</button>
  </form>
</body>
</html>